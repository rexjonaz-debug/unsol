---
const games = [
  {
    title: "Neon Survivor",
    desc: "Sobrevive a oleadas infinitas de enemigos en una arena cyberpunk llena de luces neón.",
    url: "/games/neon-survivor/"
  }
];
---

<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<title>Unsol Games - Juegos Gratis Online</title>

<meta name="description"
content="Juega gratis online. Acción, supervivencia, arcade y nuevos juegos web sin descargar.">

<link rel="canonical" href="https://unsol-pe.top/" />

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#060816;
color:white;
}

.hero{
padding:80px 20px;
text-align:center;
background:
radial-gradient(circle at center,#00e5ff33,transparent 40%),
radial-gradient(circle at top,#ff00ff22,transparent 35%);
}

h1{
font-size:60px;
margin:0;
}

.subtitle{
max-width:800px;
margin:auto;
font-size:20px;
opacity:.85;
}

.games{
max-width:1200px;
margin:auto;
padding:40px 20px;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:25px;
}

.card{
background:#10172a;
border-radius:20px;
padding:20px;
transition:.3s;
}

.card:hover{
transform:translateY(-5px);
}

.play{
display:inline-block;
padding:12px 24px;
background:#00e5ff;
color:black;
font-weight:bold;
text-decoration:none;
border-radius:12px;
}

footer{
padding:30px;
text-align:center;
opacity:.7;
}
</style>
</head>

<body>

<section class="hero">
<h1>UNSOL GAMES</h1>
<p class="subtitle">
Juegos online gratuitos, rápidos y sin instalación.
</p>
</section>

<section class="games">
{
games.map(game=>(
<div class="card">
<h2>{game.title}</h2>
<p>{game.desc}</p>
<a class="play" href={game.url}>
Jugar Ahora
</a>
</div>
))
}
</section>

<footer>
© 2026 Unsol Games
</footer>

</body>
</html>

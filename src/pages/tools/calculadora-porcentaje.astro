---
import Layout from '../../layouts/Layout.astro';

const title =
"Advanced Percentage Calculator (Free) – Calculate Percentages, Discounts & Increases";

const description =
"Free advanced percentage calculator. Calculate discounts, increases, decreases, taxes, savings and percentage values instantly.";
---

<Layout

title={title}

description={description}

canonical="https://unsol-pe.top/tools/calculadora-porcentaje/"

>

<section class="hero">

<div class="badge">

FREE ONLINE TOOL

</div>

<h1>

Advanced Percentage Calculator

</h1>

<p>

Calculate percentages, discounts, increases,

decreases, taxes and savings instantly.

Fast, modern and completely free.

</p>

</section>

<section class="calculator">

<div class="card">

<h2>

Percentage Calculator

</h2>

<div class="inputs">

<input

id="num"

type="number"

inputmode="decimal"

placeholder="Enter number"

/>

<input

id="percent"

type="number"

inputmode="decimal"

placeholder="Enter percentage"

/>

</div>

<button onclick="calculate()">

Calculate Percentage

</button>

<div id="result">

Result appears here

</div>

</div>

</section>

<section class="content">

<h2>

What is a percentage?

</h2>

<p>

Percentages represent proportions out of 100.

Businesses, ecommerce, taxes, salaries,

shopping discounts and financial reports

depend heavily on percentage calculations.

</p>

<h2>

Common Uses

</h2>

<ul>

<li>Shopping discounts</li>

<li>Salary increases</li>

<li>Tax calculations</li>

<li>Business analytics</li>

<li>School grades</li>

<li>Financial reports</li>

<li>Investments</li>

</ul>

<h2>

Examples

</h2>

<p>

20% of 500 = 100

</p>

<p>

15% discount on 1000 = 850

</p>

<p>

10% salary increase on 2000 = 2200

</p>

<h2>

Frequently Asked Questions

</h2>

<h3>

How do you calculate percentages?

</h3>

<p>

Multiply the value by the percentage and divide by 100.

</p>

<h3>

Can percentages exceed 100%?

</h3>

<p>

Yes. Growth metrics, returns and statistics frequently exceed 100%.

</p>

<h3>

How are discounts calculated?

</h3>

<p>

Subtract the discount amount from the original price.

</p>

<h3>

Why percentages matter?

</h3>

<p>

Percentages make comparisons easier across different values.

</p>

<h2>

Why use this calculator?

</h2>

<p>

This tool provides fast calculations without complicated spreadsheets,

making it ideal for students, businesses, shopping and finance.

</p>

</section>

<script>

window.calculate=()=>{

const a=parseFloat(

document.getElementById("num").value

);

const b=parseFloat(

document.getElementById("percent").value

);

const result=document.getElementById("result");

if(isNaN(a)||isNaN(b)){

result.innerHTML=

"Please enter valid numbers";

return;

}

const r=(a*b)/100;

result.innerHTML=`

<div class="big">

${r.toLocaleString()}

</div>

<div>

${b}% of ${a}

</div>

`;

}

</script>

<style>

.hero{

text-align:center;

padding:60px 20px;

}

.badge{

display:inline-block;

padding:10px 18px;

border-radius:999px;

background:#1e293b;

margin-bottom:20px;

font-size:14px;

}

.hero h1{

font-size:56px;

margin:0;

}

.hero p{

max-width:700px;

margin:auto;

font-size:20px;

opacity:.9;

}

.calculator{

display:flex;

justify-content:center;

}

.card{

width:min(900px,100%);

padding:35px;

border-radius:28px;

background:

linear-gradient(

180deg,

#172554,

#111827

);

box-shadow:

0 0 80px rgba(0,0,0,.35);

}

.inputs{

display:grid;

grid-template-columns:1fr 1fr;

gap:20px;

margin-bottom:20px;

}

input{

padding:20px;

font-size:20px;

border:none;

border-radius:18px;

}

button{

width:100%;

padding:22px;

border:none;

font-size:22px;

cursor:pointer;

border-radius:20px;

background:

linear-gradient(

90deg,

#22d3ee,

#8b5cf6

);

}

#result{

margin-top:30px;

text-align:center;

font-size:22px;

}

.big{

font-size:54px;

font-weight:bold;

}

.content{

max-width:900px;

margin:auto;

padding:60px 10px;

line-height:1.9;

}

@media(max-width:700px){

.inputs{

grid-template-columns:1fr;

}

.hero h1{

font-size:42px;

}

}

</style>

</Layout>

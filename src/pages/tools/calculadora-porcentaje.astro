---
---

<html lang="es">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,initial-scale=1">

<title>

Calculadora Profesional de Porcentajes

</title>

<meta
name="description"
content="Calculadora moderna con estadísticas, paneles y cálculos avanzados."
>

<style>

:root{

--bg:#0b1020;

--panel:#131a2d;

--panel2:#18233c;

--border:#283452;

--text:#eef3ff;

--muted:#9eaacf;

--primary:#6d5dfc;

--primary2:#2f7cf7;

--green:#10b981;

}

*{

box-sizing:border-box;

margin:0;

padding:0;

}

body{

font-family:

Inter,
system-ui,
sans-serif;

background:

radial-gradient(
circle at top,
rgba(109,93,252,.25),
transparent 30%
),

radial-gradient(
circle at right,
rgba(47,124,247,.20),
transparent 25%
),

var(--bg);

color:

var(--text);

min-height:

100vh;

}

.container{

width:

min(
1200px,
calc(100% - 30px)
);

margin:auto;

padding:

30px 0 70px;

}

.header{

display:flex;

justify-content:

space-between;

align-items:center;

margin-bottom:

30px;

}

.logo{

font-weight:

800;

font-size:

1.3rem;

}

.hero{

margin-bottom:

35px;

}

.hero h1{

font-size:

clamp(
2.5rem,
6vw,
5rem
);

line-height:

1;

margin-bottom:

15px;

}

.hero p{

color:

var(--muted);

max-width:

700px;

line-height:

1.7;

}

.layout{

display:grid;

grid-template-columns:

420px
1fr;

gap:

24px;

}

@media(max-width:980px){

.layout{

grid-template-columns:

1fr;

}

}

.panel{

background:

rgba(
19,26,45,.9
);

border:

1px solid var(--border);

border-radius:

28px;

padding:

26px;

backdrop-filter:

blur(25px);

}

label{

display:block;

margin-bottom:

8px;

font-weight:

700;

}

input,
select{

width:100%;

padding:

16px;

border-radius:

16px;

border:

1px solid var(--border);

background:

var(--panel2);

color:

white;

margin-bottom:

18px;

font-size:

1rem;

}

.resultHero{

background:

linear-gradient(
135deg,
var(--primary),
var(--primary2)
);

padding:

30px;

border-radius:

26px;

margin-bottom:

20px;

}

.resultValue{

font-size:

clamp(
3rem,
8vw,
5rem
);

font-weight:

900;

margin-top:

8px;

}

.stats{

display:grid;

grid-template-columns:

repeat(
3,
1fr
);

gap:

16px;

}

@media(max-width:700px){

.stats{

grid-template-columns:

1fr;

}

}

.card{

background:

var(--panel2);

padding:

24px;

border-radius:

20px;

border:

1px solid var(--border);

}

.card small{

display:block;

color:

var(--muted);

margin-bottom:

10px;

}

.card strong{

font-size:

1.8rem;

}

.chartWrap{

display:flex;

justify-content:

center;

align-items:

center;

padding:

20px;

}

.circle{

width:

220px;

height:

220px;

position:

relative;

}

.circle svg{

transform:

rotate(
-90deg
);

}

.center{

position:

absolute;

inset:0;

display:flex;

flex-direction:

column;

justify-content:

center;

align-items:

center;

font-weight:

800;

}

.center span{

color:

var(--muted);

font-size:

.9rem;

}

.footerGrid{

margin-top:

24px;

display:grid;

grid-template-columns:

1fr 1fr;

gap:

20px;

}

@media(max-width:700px){

.footerGrid{

grid-template-columns:

1fr;

}

}

.info{

padding:

24px;

border-radius:

20px;

background:

var(--panel2);

border:

1px solid var(--border);

line-height:

1.7;

color:

var(--muted);

}

</style>

</head>

<body>

<div class="container">

<div class="header">

<div class="logo">

Unsol Tools

</div>

<a href="/">

Inicio

</a>

</div>

<div class="hero">

<h1>

Calculadora Inteligente
de Porcentajes

</h1>

<p>

Calcula descuentos, incrementos, proporciones y analiza resultados visualmente.

</p>

</div>

<div class="layout">

<div class="panel">

<label>

Operación

</label>

<select id="mode">

<option value="percent">

X% de Y

</option>

<option value="increase">

Incrementar %

</option>

<option value="discount">

Descuento %

</option>

<option value="find">

Qué porcentaje representa

</option>

</select>

<label>

Valor principal

</label>

<input
id="a"
type="number"
placeholder="100">

<label>

Segundo valor / porcentaje

</label>

<input
id="b"
type="number"
placeholder="20">

</div>

<div>

<div class="resultHero">

Resultado

<div
class="resultValue"
id="result">

0

</div>

</div>

<div class="stats">

<div class="card">

<small>

Base

</small>

<strong id="base">

0

</strong>

</div>

<div class="card">

<small>

Cambio

</small>

<strong id="change">

0

</strong>

</div>

<div class="card">

<small>

Final

</small>

<strong id="final">

0

</strong>

</div>

</div>

<div class="panel chartWrap">

<div class="circle">

<svg
width="220"
height="220">

<circle
cx="110"
cy="110"
r="90"
stroke="#24304d"
stroke-width="18"
fill="none"
/>

<circle
id="progress"

cx="110"
cy="110"

r="90"

stroke="#10b981"

stroke-linecap="round"

stroke-width="18"

fill="none"

stroke-dasharray="565"

stroke-dashoffset="565"
/>

</svg>

<div class="center">

<div id="percentLabel">

0%

</div>

<span>

Visualización

</span>

</div>

</div>

</div>

<div class="footerGrid">

<div class="info">

Esta herramienta actualiza automáticamente mientras escribes.

</div>

<div class="info">

Útil para descuentos, estudios, impuestos, estadísticas y precios.

</div>

</div>

</div>

</div>

</div>

<script>

const mode=
document.getElementById(
"mode"
);

const a=
document.getElementById(
"a"
);

const b=
document.getElementById(
"b"
);

const result=
document.getElementById(
"result"
);

const base=
document.getElementById(
"base"
);

const change=
document.getElementById(
"change"
);

const final=
document.getElementById(
"final"
);

const progress=
document.getElementById(
"progress"
);

const percentLabel=
document.getElementById(
"percentLabel"
);

function calc(){

const n=

parseFloat(
a.value
)||0;

const p=

parseFloat(
b.value
)||0;

let r=0;

let c=0;

let f=0;

switch(
mode.value
){

case "percent":

r=(n*p)/100;

c=r;

f=r;

break;

case "increase":

c=(n*p)/100;

r=n+c;

f=r;

break;

case "discount":

c=(n*p)/100;

r=n-c;

f=r;

break;

case "find":

r=

p===0

?0

:(n/p)*100;

f=r;

break;

}

result.innerText=
r.toFixed(2);

base.innerText=
n.toFixed(2);

change.innerText=
c.toFixed(2);

final.innerText=
f.toFixed(2);

let visual=
Math.min(
100,
Math.abs(r)
);

const circumference=565;

const offset=

circumference-

(
visual/100
)
*
circumference;

progress.style.strokeDashoffset=

offset;

percentLabel.innerText=

visual.toFixed(0)+"%";

}

[
mode,
a,
b

].forEach(

x=>

x.addEventListener(
"input",
calc
)

);

calc();

</script>

</body>

</html>


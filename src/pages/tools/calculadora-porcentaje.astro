---
const title="Percentage Calculator (Free) – Calculate Percentages, Discounts & Changes Instantly";
const description="Free online percentage calculator. Calculate discounts, percentage increases, decreases, price changes and percentages instantly.";
---

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width,initial-scale=1">

<title>{title}</title>

<meta name="description" content={description}>

<style>

:root{

--bg:#08111f;
--card:rgba(255,255,255,.06);

--blue:#3b82f6;

--purple:#8b5cf6;

--green:#22c55e;

}

*{

box-sizing:border-box;

}

body{

margin:0;

font-family:

system-ui;

background:

linear-gradient(
135deg,
#07111f,
#101827,
#0b1220
);

color:white;

}

.container{

max-width:1400px;

margin:auto;

padding:40px 20px;

}

.hero{

text-align:center;

padding:40px 0;

}

.hero h1{

font-size:3.3rem;

margin:0;

}

.hero p{

opacity:.8;

font-size:1.1rem;

}

.stats{

display:grid;

grid-template-columns:

repeat(auto-fit,minmax(200px,1fr));

gap:20px;

margin:40px 0;

}

.stat{

background:var(--card);

padding:28px;

border-radius:22px;

backdrop-filter:blur(14px);

text-align:center;

}

.stat span{

font-size:2rem;

font-weight:bold;

display:block;

}

.grid{

display:grid;

grid-template-columns:

repeat(auto-fit,minmax(330px,1fr));

gap:25px;

}

.card{

background:var(--card);

padding:28px;

border-radius:24px;

backdrop-filter:blur(15px);

transition:.25s;

}

.card:hover{

transform:
translateY(-6px);

}

.card h3{

margin-top:0;

}

input{

width:100%;

padding:16px;

margin:10px 0;

border:none;

border-radius:14px;

background:#1c2842;

color:white;

font-size:1rem;

}

button{

width:100%;

padding:16px;

border:none;

cursor:pointer;

font-size:1rem;

font-weight:bold;

border-radius:14px;

background:

linear-gradient(
90deg,
var(--blue),
var(--purple)
);

color:white;

}

.result{

margin-top:20px;

font-size:2rem;

font-weight:bold;

color:var(--green);

min-height:45px;

}

.content{

margin-top:80px;

line-height:1.9;

opacity:.95;

}

</style>

</head>

<body>

<div class="container">

<div class="hero">

<h1>

Advanced Percentage Calculator

</h1>

<p>

Calculate percentages, discounts, growth and percentage changes instantly.

</p>

</div>


<div class="stats">

<div class="stat">

<span>4</span>

Powerful Tools

</div>

<div class="stat">

<span>100%</span>

Free

</div>

<div class="stat">

<span>Fast</span>

Instant Results

</div>

</div>


<div class="grid">

<div class="card">

<h3>

What % is X of Y?

</h3>

<input id=a1 type=number step=any placeholder="Value">

<input id=b1 type=number step=any placeholder="Total">

<button id=btn1>

Calculate Percentage

</button>

<div id=r1 class=result></div>

</div>


<div class="card">

<h3>

What is X% of Y?

</h3>

<input id=a2 type=number step=any placeholder="%">

<input id=b2 type=number step=any placeholder="Number">

<button id=btn2>

Calculate Result

</button>

<div id=r2 class=result></div>

</div>


<div class="card">

<h3>

Increase by %

</h3>

<input id=a3 type=number step=any placeholder="Value">

<input id=b3 type=number step=any placeholder="%">

<button id=btn3>

Calculate Increase

</button>

<div id=r3 class=result></div>

</div>


<div class="card">

<h3>

Discount Calculator

</h3>

<input id=a4 type=number step=any placeholder="Price">

<input id=b4 type=number step=any placeholder="Discount %">

<button id=btn4>

Calculate Discount

</button>

<div id=r4 class=result></div>

</div>

</div>



<div class="content">

<h2>

How To Use This Percentage Calculator

</h2>

<p>

Enter your numbers above and calculate percentages instantly.

</p>


<h2>

Examples

</h2>

<p>

20 is what percent of 100 = 20%

</p>

<p>

30% discount on 100 = 70

</p>


<h2>

Frequently Asked Questions

</h2>

<p>

Can I calculate discounts?

Yes.

Can I calculate percentage increases?

Yes.

</p>

</div>

</div>


<script is:inline>

function n(id){

return parseFloat(

document.getElementById(id).value

)||0

}

function s(id,val){

document.getElementById(id)

.textContent=val

}

btn1.onclick=()=>{

s("r1",

((n("a1")/n("b1"))*100)

.toFixed(2)+"%")

}

btn2.onclick=()=>{

s("r2",

((n("a2")*n("b2"))/100)

.toFixed(2))

}

btn3.onclick=()=>{

s("r3",

(n("a3")*(1+n("b3")/100))

.toFixed(2))

}

btn4.onclick=()=>{

s("r4",

(

n("a4")-

n("a4")*n("b4")/100

).toFixed(2))

}

</script>

</body>

</html>


---
import Layout from '../../layouts/Layout.astro';

const title =
"Discount Calculator – Instantly Calculate Sale Prices, Savings & Deals";

const description =
"Free discount calculator. Find sale prices, savings, percentage discounts and compare deals instantly.";
---

<Layout
title={title}
description={description}
canonical="https://unsol-pe.top/tools/discount-calculator/"
>

<section class="hero">
  <div class="badge">POPULAR SHOPPING TOOL</div>

  <h1>Discount Calculator</h1>

  <p>
    Instantly calculate sale prices, savings,
    percentage discounts and compare offers.
    Perfect for shopping, ecommerce and personal finance.
  </p>
</section>

<section class="calculator">

  <div class="card">

    <h2>Calculate Your Discount</h2>

    <div class="inputs">

      <input
        id="price"
        type="number"
        inputmode="decimal"
        placeholder="Original Price"
      />

      <input
        id="discount"
        type="number"
        inputmode="decimal"
        placeholder="Discount %"
      />

    </div>

    <button onclick="calculateDiscount()">
      Calculate Savings
    </button>

    <div id="results">

      <div class="placeholder">
        Enter a price and discount percentage
      </div>

    </div>

  </div>

</section>

<section class="stats">

  <div class="stat">
    <span>Save Money</span>
  </div>

  <div class="stat">
    <span>Compare Deals</span>
  </div>

  <div class="stat">
    <span>Calculate Instantly</span>
  </div>

</section>

<section class="content">

<h2>What Is a Discount Calculator?</h2>

<p>
A discount calculator helps determine how much money
you save during a sale. Instead of calculating percentages manually,
you instantly see the final price and total savings.
</p>

<h2>Why People Use Discount Calculators</h2>

<p>
Millions of shoppers use discount calculators before making purchases.
They help compare deals, understand sale prices and avoid misleading promotions.
</p>

<ul>
<li>Shopping during seasonal sales</li>
<li>Black Friday discounts</li>
<li>Online store promotions</li>
<li>Retail price comparisons</li>
<li>Business purchasing decisions</li>
<li>Budget planning</li>
</ul>

<h2>Examples</h2>

<p>
A $500 item with a 20% discount saves $100 and costs $400.
</p>

<p>
A $1000 item with a 35% discount saves $350 and costs $650.
</p>

<p>
A $250 item with a 10% discount saves $25 and costs $225.
</p>

<h2>Shopping Tips</h2>

<p>
Always compare the final price instead of focusing only on the discount percentage.
Some stores advertise large discounts while competitors still offer lower prices.
</p>

<h2>Frequently Asked Questions</h2>

<h3>How do I calculate a discount?</h3>

<p>
Multiply the original price by the discount percentage and subtract the result from the original price.
</p>

<h3>How do I find my savings?</h3>

<p>
Savings equal the original price multiplied by the discount percentage.
</p>

<h3>Can I calculate large discounts?</h3>

<p>
Yes. The calculator works for any percentage discount.
</p>

<h3>Is this calculator free?</h3>

<p>
Yes. It is completely free and works on desktop and mobile devices.
</p>

<h3>Why compare discounts?</h3>

<p>
Comparing discounts helps you make smarter purchasing decisions and maximize savings.
</p>

</section>

<script>

window.calculateDiscount = () => {

const price =
parseFloat(document.getElementById("price").value);

const discount =
parseFloat(document.getElementById("discount").value);

const results =
document.getElementById("results");

if(isNaN(price) || isNaN(discount)){

results.innerHTML =
'<div class="error">Please enter valid numbers</div>';

return;

}

const savings =
(price * discount) / 100;

const finalPrice =
price - savings;

results.innerHTML = `

<div class="result-grid">

<div class="result-card">

<div class="label">
Final Price
</div>

<div class="value">
$${finalPrice.toLocaleString()}
</div>

</div>

<div class="result-card">

<div class="label">
You Save
</div>

<div class="value">
$${savings.toLocaleString()}
</div>

</div>

</div>

`;

}

</script>

<style>

.hero{
text-align:center;
padding:70px 20px;
}

.badge{
display:inline-block;
padding:10px 18px;
border-radius:999px;
background:#1e293b;
font-size:14px;
margin-bottom:20px;
}

.hero h1{
font-size:56px;
margin:0;
}

.hero p{
max-width:760px;
margin:auto;
font-size:20px;
opacity:.9;
}

.calculator{
display:flex;
justify-content:center;
}

.card{
width:min(950px,100%);
padding:35px;
border-radius:28px;
background:linear-gradient(180deg,#172554,#111827);
box-shadow:0 0 80px rgba(0,0,0,.35);
}

.inputs{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
margin-bottom:20px;
}

input{
padding:20px;
font-size:20px;
border:none;
border-radius:18px;
}

button{
width:100%;
padding:22px;
border:none;
font-size:22px;
cursor:pointer;
border-radius:20px;
background:linear-gradient(90deg,#22d3ee,#8b5cf6);
}

#results{
margin-top:30px;
}

.result-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.result-card{
padding:25px;
border-radius:20px;
background:#0f172a;
text-align:center;
}

.label{
font-size:15px;
opacity:.8;
}

.value{
font-size:40px;
font-weight:bold;
margin-top:10px;
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
max-width:900px;
margin:40px auto;
}

.stat{
padding:20px;
border-radius:18px;
background:#151d36;
text-align:center;
}

.content{
max-width:900px;
margin:auto;
padding:60px 10px;
line-height:1.9;
}

.error{
text-align:center;
font-size:20px;
}

.placeholder{
text-align:center;
font-size:18px;
opacity:.8;
}

@media(max-width:700px){

.inputs{
grid-template-columns:1fr;
}

.result-grid{
grid-template-columns:1fr;
}

.stats{
grid-template-columns:1fr;
}

.hero h1{
font-size:42px;
}

}

</style>

</Layout>
